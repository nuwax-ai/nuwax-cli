# ============================================================================
# 单元测试 fixtures - 环境变量
# ----------------------------------------------------------------------------
# 用途: nuwax-cli 单元测试验证用,不用于真实部署
# 注意: 所有账号密码均为测试占位值(nuwax_test 前缀),非真实凭据
# 源:   build-agent-docker/docker/.env (经脱敏/测试化处理)
# ============================================================================

# Docker Registry 配置
# 阿里云镜像仓库
DOCKER_REGISTRY=nuwax-docker-images-registry.cn-hangzhou.cr.aliyuncs.com/nuwax
FRONTEND_VERSION=latest
BACKEND_VERSION=latest
RUST_VERSION=latest
MCP_PROXY_VERSION=latest
LOG_PLATFORM_VERSION=latest
VIDEO_ANALYSIS_VERSION=latest
RCODER_VERSION=latest
# 前端端口
FRONTEND_HOST_PORT=80

# MySQL 配置 (测试账号密码)
MYSQL_ROOT_PASSWORD=nuwax_test_root
MYSQL_USER=nuwax_test
MYSQL_PASSWORD=nuwax_test_pass
MYSQL_DATABASE=agent_platform
MYSQL_CUSTOM_DATABASE=agent_custom_table
MYSQL_PORT=3306
MYSQL_UID=999
MYSQL_GID=999
DATABASE_URL=jdbc:mysql://mysql:${MYSQL_PORT}/${MYSQL_DATABASE}?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai

# Elasticsearch 配置
ELASTICSEARCH_UID=1000
ELASTICSEARCH_GID=1000
ELASTICSEARCH_PASSWORD=nuwax_test_es

# SurrealDB 配置
SURREALDB_UID=65532
SURREALDB_GID=65532
SURREALDB_USER=nuwax_test
SURREALDB_PASSWORD=nuwax_test_surreal

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=nuwax_test_redis
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# Milvus 配置
MILVUS_PORT=19530
MILVUS_HOST=milvus
MILVUS_URI=http://${MILVUS_HOST}:${MILVUS_PORT}
# 认证开关: false=不校验密码(默认), true=开启认证(需 backend 端凭据一致)
MILVUS_AUTHORIZATION_ENABLED=false
MILVUS_USER=nuwax_test
MILVUS_PASSWORD=nuwax_test_milvus

# MinIO 配置
MINIO_ROOT_USER=nuwax_test
MINIO_ROOT_PASSWORD=nuwax_test_minio

# 前端项目配置 (Git configurations moved to project root .env)
# FRONTEND_REPO, FRONTEND_BRANCH, FRONTEND_DIR are now in ../.env

# 后端项目配置 (Git configurations moved to project root .env)
# BACKEND_REPO, BACKEND_BRANCH, BACKEND_DIR are now in ../.env

# Rust项目配置 (Git configurations moved to project root .env)
# RUST_REPO, RUST_BRANCH, RUST_DIR are now in ../.env

# MCP Proxy项目配置 (Git configurations moved to project root .env)
# MCP_PROXY_REPO, MCP_PROXY_BRANCH, MCP_PROXY_DIR are now in ../.env

# Log Platform项目配置 (Git configurations moved to project root .env)
# LOG_PLATFORM_REPO, LOG_PLATFORM_BRANCH, LOG_PLATFORM_DIR are now in ../.env

# Video Analysis项目配置 (Git configurations moved to project root .env)
# VIDEO_ANALYSIS_REPO, VIDEO_ANALYSIS_BRANCH, VIDEO_ANALYSIS_DIR are now in ../.env

# rcoder项目配置 (Git configurations moved to project root .env)
# RCODER_REPO, RCODER_BRANCH, RCODER_DIR are now in ../.env

# 前端工程 subapp-deployer配置 (Git configurations moved to project root .env)
# SUBAPP_DEPLOYER_REPO, SUBAPP_DEPLOYER_BRANCH, SUBAPP_DEPLOYER_DIR are now in ../.env

# JAVA工程配置
APP_PROFILE=test
APP_DEBUG_PORT=5005
APP_PORT=8080

# Doris 配置
# doris_fe 的内部ip地址
DORIS_HOST=172.20.80.2
DORIS_VERSION=3.0.4
DORIS_HOME=/opt/apache-doris/fe
DORIS_ROOT_USERNAME=nuwax_test
DORIS_PORT=9030
DORIS_USER=nuwax_test
# 默认账号 root,admin 密码为空
DORIS_PASSWORD=nuwax_test_doris
DORIS_DB=agent_custom_table
